{% from 'components/visual.njk' import visual %}
<article class="project-card{% if featuredCard %} project-card-featured{% endif %}{% if project.data.cover %} project-card-has-cover{% endif %}" data-project data-category="{{ project.data.category }}" data-chart="{{ project.data.chart or 'revenue' }}">
  <a class="project-card-link" href="{{ project.url | url }}">
    <div class="project-card-art" aria-hidden="true">{% if project.data.cover %}<img class="project-cover-image" src="{{ project.data.cover | url }}" alt="" loading="lazy" decoding="async"{% if project.data.coverWidth and project.data.coverHeight %} width="{{ project.data.coverWidth }}" height="{{ project.data.coverHeight }}"{% endif %}>{% else %}{{ visual(project.data.chart, project.data.title) }}{% endif %}</div>
    <div class="project-card-overlay">
      <div class="project-card-top">
        <span>[{{ projectNumber or '00' }}] {{ project.data.category }}</span>
        {% if project.data.example %}<span class="sample-label">Example project</span>{% endif %}
      </div>
      <div class="project-card-copy">
        {% if project.data.highlight %}<p class="project-highlight">{{ project.data.highlight }}</p>{% endif %}
        <h3>{{ project.data.title }} <span class="card-arrow" aria-hidden="true">↗</span></h3>
        <p>{{ project.data.description }}</p>
        <ul class="tag-list">{% for tool in project.data.tools %}<li class="tag">{{ tool }}</li>{% endfor %}</ul>
        <span class="card-cta">open case study <span aria-hidden="true">→</span></span>
      </div>
    </div>
  </a>
</article>
