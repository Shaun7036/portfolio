---
layout: layouts/base.njk
---
{% from "components/visual.njk" import visual %}
<article class="page-shell project-detail">
  <header class="page-intro">
    <a class="back-link" href="{{ '/projects/' | url }}"><span aria-hidden="true">←</span> All projects</a>
    <p class="eyebrow">{{ category }} <span aria-hidden="true">/</span> {{ year }}</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ description }}</p>
    <ul class="tag-list" aria-label="Project tools">{% for tool in tools %}<li class="tag">{{ tool }}</li>{% endfor %}</ul>
  </header>
  <figure class="project-cover">
    {% if cover %}<img class="project-cover-image" src="{{ cover | url }}" alt="{{ coverAlt or title }}" decoding="async"{% if coverWidth and coverHeight %} width="{{ coverWidth }}" height="{{ coverHeight }}"{% endif %}>{% else %}{{ visual(chart, title) }}{% endif %}
    <figcaption>{% if cover %}{{ visualCaption or title }}{% else %}Illustrative visualization · Demonstration data only{% endif %}</figcaption>
  </figure>
  {% if example %}<p class="example-notice">Example case study. This page demonstrates the project structure; replace it with your own work and results.</p>{% endif %}
  <div class="detail-grid">
    <div class="prose project-prose">{{ content | safe }}</div>
    <aside class="sidebar-note" aria-label="Project at a glance">
      <p class="section-label">Project at a glance</p>
      <dl>
        <dt>My role</dt><dd>{{ role }}</dd>
        <dt>Timeline</dt><dd>{{ duration }}</dd>
        <dt>Data</dt><dd>{{ dataset }}</dd>
        <dt>Deliverable</dt><dd>{{ outcome }}</dd>
      </dl>
      {% if repository or dashboard %}<div class="project-links">
        {% if repository %}<a class="text-link" href="{{ repository }}" target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>{% endif %}
        {% if dashboard %}<a class="text-link" href="{{ dashboard }}" target="_blank" rel="noopener noreferrer">Explore dashboard <span aria-hidden="true">↗</span></a>{% endif %}
      </div>{% endif %}
    </aside>
  </div>
  <div class="page-cta"><p>Another question. Another perspective.</p><a class="text-link" href="{{ '/projects/' | url }}">Explore all projects <span aria-hidden="true">↗</span></a></div>
</article>
