---
layout: layouts/base.njk
---
<article class="page-shell post-detail">
  <header class="page-intro">
    <a class="back-link" href="{{ '/writing/' | url }}"><span aria-hidden="true">←</span> All writing</a>
    <p class="eyebrow">{{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ description }}</p>
    <p class="post-meta"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time> <span aria-hidden="true">·</span> {{ content | readingTime }} min read {% if not example %}<span aria-hidden="true">·</span> {{ site.name }}{% endif %}</p>
  </header>
  <div class="post-body">
    {% if example %}<p class="example-notice">Sample article · A starting point for your own writing.</p>{% endif %}
    <div class="prose">{{ content | safe }}</div>
    <div class="page-cta"><p>Keep exploring.</p><a class="text-link" href="{{ '/writing/' | url }}">More notes & ideas <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
