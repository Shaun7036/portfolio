<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#fbfaf7">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }} — {{ site.role }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }} · {{ site.role }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if page.url | isSection('/writing/') and page.url != '/writing/' %}article{% else %}website{% endif %}">
  {% if site.url %}<link rel="canonical" href="{{ page.url | url | absoluteUrl(site.url) }}">
  <meta property="og:url" content="{{ page.url | url | absoluteUrl(site.url) }}">{% endif %}
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
  <script src="{{ '/assets/js/site.js' | url }}" defer></script>
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header page-shell">
    <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }} home"><span>{{ site.name }}</span><b aria-hidden="true">.</b><small>{{ site.role }}</small></a>
    <nav class="main-nav" aria-label="Main navigation">
      {% set links = [{label:'work',url:'/projects/'},{label:'about',url:'/about/'},{label:'writing',url:'/writing/'},{label:'résumé',url:'/resume/'},{label:'contact',url:'/contact/'}] %}
      {% for link in links %}<a href="{{ link.url | url }}"{% if page.url | isSection(link.url) %} aria-current="page"{% endif %}>{{ link.label }}{% if link.label == 'résumé' or link.label == 'contact' %}<span aria-hidden="true"> ↗</span>{% endif %}</a>{% endfor %}
    </nav>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer page-shell">
    <div class="footer-invitation">
      <p>say hello<span aria-hidden="true">.</span></p>
      {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }} <span aria-hidden="true">↗</span></a>{% else %}<a href="{{ '/contact/' | url }}">start a conversation <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    <div class="footer-columns">
      <nav aria-label="Explore the portfolio"><span>explore</span><a href="{{ '/projects/' | url }}">projects</a><a href="{{ '/about/' | url }}">about me</a><a href="{{ '/writing/' | url }}">writing</a></nav>
      <nav aria-label="Professional links"><span>details</span><a href="{{ '/credentials/' | url }}">credentials</a><a href="{{ '/resume/' | url }}">résumé</a><a href="{{ '/contact/' | url }}">contact</a></nav>
      <nav aria-label="Find me online"><span>find me</span>{% if site.linkedin %}<a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">linkedin ↗</a>{% endif %}{% if site.github %}<a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">github ↗</a>{% endif %}{% if not site.linkedin and not site.github %}<a href="{{ '/contact/' | url }}">links coming soon</a>{% endif %}</nav>
    </div>
    <div class="footer-base"><a class="footer-name" href="{{ '/' | url }}">{{ site.name }}.</a><span class="copyright">© {{ buildYear }} · built as a fast static site</span></div>
  </footer>
</body>
</html>
