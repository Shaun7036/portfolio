<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#f8f9f6">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }} — {{ site.role }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }} · {{ site.role }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="{% if page.url | isSection('/writing/') and page.url != '/writing/' %}article{% else %}website{% endif %}">
  {% if site.url %}<link rel="canonical" href="{{ page.url | url | absoluteUrl(site.url) }}">
  <meta property="og:url" content="{{ page.url | url | absoluteUrl(site.url) }}">{% endif %}
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
  <script src="{{ '/assets/js/site.js' | url }}" defer></script>
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header page-shell">
    <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }} home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>{{ site.name }}<small>{{ site.role }}</small></span></a>
    <nav class="main-nav" aria-label="Main navigation">
      {% set links = [{label:'Work',url:'/projects/'},{label:'About',url:'/about/'},{label:'Writing',url:'/writing/'},{label:'Résumé',url:'/resume/'},{label:'Contact',url:'/contact/'}] %}
      {% for link in links %}<a href="{{ link.url | url }}"{% if page.url | isSection(link.url) %} aria-current="page"{% endif %}>{{ link.label }}{% if link.label == 'Contact' %}<span aria-hidden="true"> ↗</span>{% endif %}</a>{% endfor %}
    </nav>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer page-shell">
    <div><a class="footer-name" href="{{ '/' | url }}">{{ site.name }}</a><p>Curiosity. Clarity. A little good data.</p></div>
    <nav aria-label="Footer navigation"><a href="{{ '/credentials/' | url }}">Credentials</a><a href="{{ '/resume/' | url }}">Résumé</a><a href="{{ '/contact/' | url }}">Get in touch <span aria-hidden="true">↗</span></a></nav>
    <span class="copyright">© {{ buildYear }} {{ site.name }}</span>
  </footer>
</body>
</html>
