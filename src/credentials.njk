---
layout: layouts/base.njk
title: Credentials
description: Education, certifications, and continued learning.
permalink: /credentials/
---
<div class="page-shell">
  <header class="page-intro">
    <p class="eyebrow">Education & continued learning</p>
    <h1>A foundation to build on.</h1>
    <p class="lede">A home for the qualifications and learning that inform your work.</p>
  </header>
  {% if credentials | hasExamples %}<p class="example-notice">Template entries below. Replace them with your own credentials before publishing.</p>{% endif %}
  <div class="credential-list">
    {% for credential in credentials %}
    <article class="credential-row">
      <div><p class="section-label">{{ credential.type }}</p><span class="credential-year">{{ credential.year }}</span></div>
      <div>
        <h2>{{ credential.title }}</h2>
        <p class="credential-issuer">{{ credential.issuer }}</p>
        <p>{{ credential.description }}</p>
        {% if credential.url %}<a class="text-link" href="{{ credential.url }}" target="_blank" rel="noopener noreferrer">Verify credential <span aria-hidden="true">↗</span></a>{% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
  <div class="page-cta"><p>See how the learning translates into practice.</p><a class="text-link" href="{{ '/projects/' | url }}">Explore the projects <span aria-hidden="true">↗</span></a></div>
</div>
