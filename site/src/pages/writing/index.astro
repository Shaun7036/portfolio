---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, isoDate, readableDate, readingTime } from "../../lib/content";
import { withBase } from "../../lib/urls";

const posts = await getPublishedPosts();
---

<BaseLayout title="Writing" description="Notes on analytics, project decisions, and making sense of data.">
  <div class="page-shell">
    <header class="page-intro"><p class="eyebrow">Notes from the work</p><h1>A little more depth.</h1><p class="lede">Project walkthroughs, questions worth exploring, and lessons from working with data.</p></header>
    <div class="writing-list">
      {posts.map((post) => <article class="writing-row"><div class="writing-meta"><span class="section-label">{post.data.category}</span><time datetime={isoDate(post.data.date)}>{readableDate(post.data.date)}</time>{post.data.example && <span class="sample-label">Sample article</span>}</div><div><h2><a href={withBase(`/writing/${post.id}/`)}>{post.data.title} <span aria-hidden="true">↗</span></a></h2><p>{post.data.description}</p><span class="reading-time">{readingTime(post.body || "")} min read</span></div></article>)}
      {posts.length === 0 && <div class="prose"><h2>Notes are on the way.</h2><p>In the meantime, take a look at the <a href={withBase("/projects/")}>project case studies</a>.</p></div>}
    </div>
  </div>
</BaseLayout>
