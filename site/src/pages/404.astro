---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <div class="page-shell"><header class="page-intro"><p class="eyebrow">404 / A missing data point</p><h1>This page isn't here.</h1><p class="lede">The link may have changed, or the page may have moved. There's more to explore from the homepage.</p><div class="button-row"><a class="button" href={withBase("/")}>Back to home <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={withBase("/projects/")}>Browse projects</a></div></header></div>
</BaseLayout>
