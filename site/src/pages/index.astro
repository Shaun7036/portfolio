---
import ProjectCard from "../components/ProjectCard.astro";
import PortfolioFilter from "../components/PortfolioFilter.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedExperiences, getPublishedPosts, getPublishedProjects, pad, readingTime } from "../lib/content";
import { buildFilterGroups } from "../lib/filters";
import { withBase } from "../lib/urls";
import site from "../data/site.json";

const projects = await getPublishedProjects();
const posts = await getPublishedPosts();
const experiences = await getPublishedExperiences();
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const homePosts = posts.slice(0, 2);
const workExperiences = experiences.filter((experience) => experience.data.section === "work");
const coCurricularExperiences = experiences.filter((experience) => experience.data.section === "co-curricular");
const filterGroups = buildFilterGroups([
  ...featuredProjects.map((project) => project.data.filterTags),
  ...experiences.map((experience) => experience.data.filterTags),
  ...homePosts.map((post) => post.data.filterTags),
]);
const totalFilterItems = featuredProjects.length + experiences.length + homePosts.length;
---

<BaseLayout title="Portfolio" bodyClass="home">
  <section class="intro page-shell" aria-labelledby="hero-title">
    <div class="intro-profile">
      <p class="mono-note">portfolio / analytics</p>
      <h1 id="hero-title">hi, i'm <span>{site.name}</span><i aria-hidden="true">↗</i></h1>
      <p class="intro-role">{site.role}</p>
      <nav class="profile-links" aria-label="Quick links">
        <a href={withBase("/projects/")}><span aria-hidden="true">01</span> work</a>
        {site.github ? <a href={site.github} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">02</span> github</a> : <a href={withBase("/resume/")}><span aria-hidden="true">02</span> résumé</a>}
        {site.linkedin ? <a href={site.linkedin} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">03</span> linkedin</a> : <a href={withBase("/contact/")}><span aria-hidden="true">03</span> contact</a>}
      </nav>
      <div class="mini-signal" aria-hidden="true">
        <span class="mini-signal-label">Above is mostly my analytics work, for a complete look at my experience scroll down to the portfolio section!</span>
        <svg viewBox="0 0 230 132"><path class="mini-grid" d="M12 24H218M12 56H218M12 88H218M12 120H218M48 12V120M88 12V120M128 12V120M168 12V120M208 12V120"></path><path class="mini-trend" d="M14 104C42 105 50 82 72 86S108 70 123 61 153 68 169 42 196 34 218 18"></path><g class="mini-points"><circle cx="28" cy="93" r="3"></circle><circle cx="51" cy="101" r="2"></circle><circle cx="72" cy="79" r="4"></circle><circle cx="95" cy="85" r="2"></circle><circle cx="117" cy="60" r="3"></circle><circle cx="141" cy="70" r="2"></circle><circle cx="166" cy="43" r="4"></circle><circle cx="190" cy="48" r="2"></circle><circle cx="215" cy="18" r="3"></circle></g></svg>
      </div>
    </div>

    <div class="intro-overview">
      <div class="data-doodles" aria-hidden="true"><span class="doodle-bars"></span><span class="doodle-orbit"></span><span class="doodle-spark">⌁</span></div>
      <p class="intro-statement">{site.intro}</p>
      <div class="fact-grid">
        {site.facts.map((fact) => <article><h2><span>[{fact.number}]</span> {fact.label}</h2><p>{fact.value}</p></article>)}
        <article><h2><span>[04]</span> status</h2><p>{site.availability} · {site.location}</p></article>
      </div>
      <figure class="data-portrait">
        <div class="data-portrait-label"><span>Recent Analytics Project</span><span>A Cross-Sport Scouter</span></div>
        <svg viewBox="0 0 720 250" aria-hidden="true"><defs><pattern id="portrait-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-opacity=".12"></path></pattern><linearGradient id="portrait-fill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#dff3ed"></stop><stop offset="1" stop-color="#e9eefb"></stop></linearGradient></defs><rect width="720" height="250" rx="20" fill="url(#portrait-fill)"></rect><rect width="720" height="250" rx="20" fill="url(#portrait-grid)"></rect><g class="portrait-bars"><rect x="56" y="150" width="28" height="52" rx="4"></rect><rect x="94" y="119" width="28" height="83" rx="4"></rect><rect x="132" y="78" width="28" height="124" rx="4"></rect><rect x="170" y="104" width="28" height="98" rx="4"></rect></g><path class="portrait-line" d="M247 179C288 177 302 119 342 132S397 158 429 95 496 58 539 88 598 97 665 40"></path><g class="portrait-points"><circle cx="247" cy="179" r="6"></circle><circle cx="342" cy="132" r="6"></circle><circle cx="429" cy="95" r="6"></circle><circle cx="539" cy="88" r="6"></circle><circle cx="665" cy="40" r="7"></circle></g><text x="55" y="41">STRUCTURE</text><text x="247" y="216">CONTEXT</text><text x="601" y="216">CLARITY →</text></svg>
        <figcaption>A ensemble model which infers inter-sport role resemblance.</figcaption>
      </figure>
    </div>
  </section>

  <div class="expertise-strip page-shell" aria-label="Core analytics interests"><span class="strip-label">Above is mostly my analytics work, for a complete look at my experience scroll down to the portfolio section!</span><span>analysis</span><i aria-hidden="true">·</i><span>visualization</span><i aria-hidden="true">·</i><span>experimentation</span><i aria-hidden="true">·</i><span>decision-making</span></div>

  <PortfolioFilter groups={filterGroups} totalItems={totalFilterItems} />

  <section id="selected-work" class="work-section work-section-filtered page-shell" aria-labelledby="work-title" data-portfolio-filter-section>
    <div class="section-heading"><div><p class="eyebrow">Selected Projects and Research</p><h2 id="work-title">Curated Portfolio<span aria-hidden="true">↗</span></h2></div><div class="section-heading-side"><p>Take a look at my complete portfolio!</p><a class="text-link" href={withBase("/projects/")}>view every project <span aria-hidden="true">↗</span></a></div></div>
    {projects.some((project) => project.data.example) && <p class="section-note">This curation is  focused more-so on my recent projects, see my complete work for a full snapshot of my experience :)</p>}
    <div class="project-grid project-grid-home">{featuredProjects.map((project, index) => <ProjectCard project={project} number={pad(index + 1)} featured={index === 0} />)}</div>
    <p class="portfolio-filter-empty" data-portfolio-filter-empty hidden>No matching projects. Try removing a filter.</p>
  </section>

  <section class="experience-section page-shell" aria-labelledby="experience-title" data-portfolio-filter-section>
    <div class="section-heading"><div><p class="eyebrow">i even have a 9-5 playlist!</p><h2 id="experience-title">Professional Experience</h2></div><div class="section-heading-side"><p>{site.storytime}</p><a class="text-link" href={withBase("/resume/")}>full résumé <span aria-hidden="true">↗</span></a></div></div>
    <div class="experience-grid">{workExperiences.map((experience, index) => <ExperienceCard experience={experience} number={index + 1} />)}</div>
    <p class="portfolio-filter-empty" data-portfolio-filter-empty hidden>No matching professional experience. Try removing a filter.</p>
  </section>

  <section class="experience-section co-curricular-section page-shell" aria-labelledby="co-curricular-title" data-portfolio-filter-section>
    <div class="section-heading"><div><p class="eyebrow">my other other interests</p><h2 id="co-curricular-title">co-curricular roles.</h2></div><div class="section-heading-side"><p>I'm very involved in student life with a ton of side-interests! Check some of them out :)</p><a class="text-link" href={withBase("/about/")}>more about me <span aria-hidden="true">↗</span></a></div></div>
    <div class="experience-grid experience-grid-co-curricular">{coCurricularExperiences.map((experience, index) => <ExperienceCard experience={experience} number={index + 1} />)}</div>
    <p class="portfolio-filter-empty" data-portfolio-filter-empty hidden>No matching co-curricular roles. Try removing a filter.</p>
    <div class="credential-shortcut"><span class="credential-mark" aria-hidden="true">⌁</span><p>Education, certifications, and continued learning live in one place.</p><a class="text-link" href={withBase("/credentials/")}>view credentials <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="writing-section page-shell" aria-labelledby="writing-title" data-portfolio-filter-section>
    <div class="section-heading"><div><p class="eyebrow">notes from the work</p><h2 id="writing-title">thinking out loud.</h2></div><div class="section-heading-side"><p>Short explanations of project choices, analytical habits, and lessons worth keeping.</p><a class="text-link" href={withBase("/writing/")}>all writing <span aria-hidden="true">↗</span></a></div></div>
    <div class="writing-list">{homePosts.map((post, index) => <article class="writing-row" data-portfolio-filter-item data-portfolio-kind="writing" data-portfolio-tags={JSON.stringify(post.data.filterTags)}><span class="writing-index">[{pad(index + 1)}]</span><div><div class="card-kicker">{post.data.category}{post.data.example && <span class="sample-label">Sample article</span>}</div><h3><a href={withBase(`/writing/${post.id}/`)}>{post.data.title}<span aria-hidden="true">↗</span></a></h3><p>{post.data.description}</p></div><span class="reading-time">{readingTime(post.body || "")} min read</span></article>)}</div>
    <p class="portfolio-filter-empty" data-portfolio-filter-empty hidden>No matching writing. Try removing a filter.</p>
  </section>

  <section class="contact-band page-shell" aria-labelledby="contact-title"><div><p class="eyebrow">one more data point</p><h2 id="contact-title">open to the next good question.</h2><p>For analytics roles, project conversations, or a simple hello.</p></div><a class="button" href={withBase("/contact/")}>let's talk <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
