---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
import site from "../data/site.json";

const emails = [site.email, ...(site.alternateEmails || [])].filter(Boolean);
---

<BaseLayout title="Contact" description="Get in touch about analytics opportunities, projects, or collaboration.">
  <div class="page-shell">
    <header class="page-intro"><p class="eyebrow">Start a conversation</p><h1>Good work starts<br />with a question.</h1><p class="lede">For opportunities, collaborations, or a conversation about the work, get in touch.</p></header>
    <div class="contact-grid">
      <section class="contact-card"><p class="section-label">01 / Email</p><h2>Say hello.</h2><p>The best place to start a conversation about a role or a project.</p>{emails.length > 0 ? <div class="contact-email-list">{emails.map((email) => <a class="text-link" href={`mailto:${email}`}>{email} <span aria-hidden="true">↗</span></a>)}</div> : <p class="contact-pending">Email address coming soon.</p>}</section>
      <section class="contact-card"><p class="section-label">02 / LinkedIn</p><h2>Connect professionally.</h2><p>A little more about my experience and professional interests.</p>{site.linkedin ? <a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">Find me on LinkedIn <span aria-hidden="true">↗</span></a> : <p class="contact-pending">LinkedIn profile coming soon.</p>}</section>
      <section class="contact-card"><p class="section-label">03 / GitHub</p><h2>Look under the hood.</h2><p>Code, notebooks, and the details behind the projects.</p>{site.github ? <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">Explore my GitHub <span aria-hidden="true">↗</span></a> : <p class="contact-pending">GitHub profile coming soon.</p>}</section>
    </div>
    <div class="page-cta"><p>Looking for a quick professional overview?</p><a class="text-link" href={withBase("/resume/")}>View my résumé <span aria-hidden="true">↗</span></a></div>
  </div>
</BaseLayout>
