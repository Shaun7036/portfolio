---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
const emails = [site.email, ...(site.alternateEmails || [])].filter(Boolean);
---
<BaseLayout title="Contact" description="Contact Shaun Lalani about analytics, engineering, and research opportunities.">
  <div class="page-shell">
    <header class="page-intro"><h1>Contact</h1><p class="lede">{site.availability}</p></header>
    <div class="contact-grid">
      <section class="contact-card"><h2>Email</h2><div class="contact-email-list">{emails.map((email) => <a class="text-link" href={`mailto:${email}`}>{email} <span aria-hidden="true">↗</span></a>)}</div></section>
      <section class="contact-card"><h2>LinkedIn</h2>{site.linkedin && <a class="text-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">View profile <span aria-hidden="true">↗</span></a>}</section>
      <section class="contact-card"><h2>GitHub</h2>{site.github && <a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">View repositories <span aria-hidden="true">↗</span></a>}</section>
    </div>
  </div>
</BaseLayout>
