---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
import site from "../data/site.json";
---

<BaseLayout title="About" description="Shaun Lalani — analytics at USC, software engineering at Multidev, and electrical engineering at McGill.">
  <div class="page-shell">
    <header class="page-intro"><h1>About me</h1><p class="lede">{site.intro}</p></header>
    <div class="detail-grid">
      <div class="prose">
        <h2>Background</h2>
        <p>I'm completing an M.S. in Analytics at <strong>University of Southern California</strong>, following a B.Eng. in Electrical Engineering with a minor in Technological Entrepreneurship at <strong>McGill University</strong>.</p>
        <p>At <strong>Multidev Technologies</strong>, I worked on shipping platforms, data pipelines, carrier integrations, and cloud infrastructure. My recent projects focus on sports analytics and data engineering.</p>
        <h2>Beyond work</h2>
        <p>Climbing, sports writing, student publications, and community involvement are also part of my time at USC and McGill.</p>
        <a class="text-link" href={withBase("/#co-curricular-title")}>Co-curricular roles <span aria-hidden="true">↗</span></a>
      </div>
      <aside class="sidebar-note" aria-label="At a glance"><p class="section-label">At a glance</p><dl><dt>Focus</dt><dd>{site.role}</dd><dt>Based in</dt><dd>{site.location}</dd><dt>Availability</dt><dd>{site.availability}</dd></dl><a class="text-link" href={withBase("/resume/")}>Résumé <span aria-hidden="true">↗</span></a><a class="text-link" href={withBase("/credentials/")}>Education & credentials <span aria-hidden="true">↗</span></a></aside>
    </div>
    <div class="owner-tools"><a href={withBase("/editor/")} rel="nofollow">Add an entry <span aria-hidden="true">↗</span></a></div>
  </div>
</BaseLayout>
