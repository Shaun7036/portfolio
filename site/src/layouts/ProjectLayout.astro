---
import type { ProjectEntry } from "../lib/content";
import { withBase } from "../lib/urls";
import BaseLayout from "./BaseLayout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";

interface Props { project: ProjectEntry }
const { project } = Astro.props;
const { data } = project;
---

<BaseLayout title={data.title} description={data.description}>
  <article class="page-shell project-detail">
    <header class="page-intro">
      <a class="back-link" href={withBase("/projects/")}><span aria-hidden="true">←</span> All projects</a>
      <p class="eyebrow">{data.category} <span aria-hidden="true">/</span> {data.year}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <ul class="tag-list" aria-label="Project tools">{data.tools.map((tool) => <li class="tag">{tool}</li>)}</ul>
    </header>
    <aside class="project-facts" aria-label="Project at a glance">
      <p class="section-label">Project at a glance</p>
      <dl>
        <div><dt>My role</dt><dd>{data.role}</dd></div>
        <div><dt>Timeline</dt><dd>{data.duration}</dd></div>
        <div><dt>Data</dt><dd>{data.dataset}</dd></div>
        <div><dt>Deliverable</dt><dd>{data.outcome}</dd></div>
      </dl>
      {(data.repository || data.dashboard) && <div class="project-links">
        {data.repository && <a class="text-link" href={data.repository} target="_blank" rel="noopener noreferrer">View repository <span aria-hidden="true">↗</span></a>}
        {data.dashboard && <a class="text-link" href={data.dashboard} target="_blank" rel="noopener noreferrer">Explore dashboard <span aria-hidden="true">↗</span></a>}
      </div>}
    </aside>
    <figure class="project-cover">
      {data.cover
        ? <img class="project-cover-image" src={withBase(data.cover)} alt={data.coverAlt || data.title} decoding="async" width={data.coverWidth} height={data.coverHeight} />
        : <ProjectVisual type={data.chart} title={data.title} />}
      <figcaption>{data.cover ? (data.visualCaption || data.title) : "Illustrative visualization · Demonstration data only"}</figcaption>
    </figure>
    {data.example && <p class="example-notice">Example case study. This page demonstrates the project structure; replace it with your own work and results.</p>}
    <div class="detail-grid project-copy-grid"><div class="prose project-prose"><slot /></div></div>
    <div class="page-cta"><p>Another question. Another perspective.</p><a class="text-link" href={withBase("/projects/")}>Explore all projects <span aria-hidden="true">↗</span></a></div>
  </article>
</BaseLayout>
