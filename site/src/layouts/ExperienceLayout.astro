---
import type { ExperienceEntry } from "../lib/content";
import { experiencePeriod } from "../lib/content";
import { withBase } from "../lib/urls";
import BaseLayout from "./BaseLayout.astro";

interface Props { experience: ExperienceEntry }
const { experience } = Astro.props;
const { data } = experience;
---

<BaseLayout title={`${data.role} at ${data.organization}`} description={data.description}>
  <article class="page-shell experience-detail">
    <header class="page-intro">
      <a class="back-link" href={withBase("/#experience-title")}><span aria-hidden="true">←</span> All experience</a>
      <p class="eyebrow">{data.organization} <span aria-hidden="true">/</span> {experiencePeriod(data.start, data.end)}</p>
      <h1>{data.role}</h1>
      <p class="lede">{data.description}</p>
      <ul class="tag-list" aria-label="Experience skills">{data.filterTags.skills.map((skill) => <li class="tag">{skill}</li>)}</ul>
    </header>

    {data.example && <p class="example-notice">Starter experience copy. Verify the role details and replace every prompt before publishing this page.</p>}

    <aside class="project-facts" aria-label="Experience at a glance">
      <p class="section-label">Experience at a glance</p>
      <dl>
        <div><dt>Organization</dt><dd>{data.organization}</dd></div>
        <div><dt>Timeline</dt><dd>{experiencePeriod(data.start, data.end)}</dd></div>
        <div><dt>Location</dt><dd>{data.location || "Not location-specific"}</dd></div>
        <div><dt>Context</dt><dd>{data.filterTags.experience.join(" · ")}</dd></div>
      </dl>
    </aside>

    <section class="experience-detail-points" aria-labelledby="experience-points-title">
      <p class="section-label">Selected responsibilities</p>
      <h2 id="experience-points-title">What I worked on</h2>
      <ul>{data.responsibilities.map((responsibility) => <li>{responsibility}</li>)}</ul>
    </section>

    <div class="detail-grid project-copy-grid"><div class="prose project-prose"><slot /></div></div>
    <div class="page-cta"><p>More work, context, and outcomes.</p><a class="text-link" href={withBase("/#experience-title")}>Back to experience <span aria-hidden="true">↗</span></a></div>
  </article>
</BaseLayout>
