---
import type { PostEntry } from "../lib/content";
import { isoDate, readableDate, readingTime } from "../lib/content";
import { withBase } from "../lib/urls";
import site from "../data/site.json";
import BaseLayout from "./BaseLayout.astro";

interface Props { post: PostEntry }
const { post } = Astro.props;
const { data } = post;
---

<BaseLayout title={data.title} description={data.description} pageType="article">
  <article class="page-shell post-detail">
    <header class="page-intro">
      <a class="back-link" href={withBase("/writing/")}><span aria-hidden="true">←</span> All writing</a>
      <p class="eyebrow">{data.category}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <p class="post-meta"><time datetime={isoDate(data.date)}>{readableDate(data.date)}</time> <span aria-hidden="true">·</span> {readingTime(post.body || "")} min read {!data.example && <><span aria-hidden="true">·</span> {site.name}</>}</p>
    </header>
    <div class="post-body">
      {data.example && <p class="example-notice">Sample article · A starting point for your own writing.</p>}
      <div class="prose"><slot /></div>
      <div class="page-cta"><p>Keep exploring.</p><a class="text-link" href={withBase("/writing/")}>More notes & ideas <span aria-hidden="true">↗</span></a></div>
    </div>
  </article>
</BaseLayout>
